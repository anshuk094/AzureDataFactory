{
	"name": "DataTransformation",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ds_silver_source",
						"type": "DatasetReference"
					},
					"name": "DimAirline"
				},
				{
					"dataset": {
						"referenceName": "ds_dimflight_source",
						"type": "DatasetReference"
					},
					"name": "DimFlight"
				},
				{
					"dataset": {
						"referenceName": "ds_dim_passenger_source",
						"type": "DatasetReference"
					},
					"name": "DimPassenger"
				},
				{
					"dataset": {
						"referenceName": "ds_fact_source",
						"type": "DatasetReference"
					},
					"name": "FactBooking"
				},
				{
					"dataset": {
						"referenceName": "ds_dim_airport",
						"type": "DatasetReference"
					},
					"name": "dimAirport"
				}
			],
			"sinks": [
				{
					"linkedService": {
						"referenceName": "AzureDataLakeLinkedService",
						"type": "LinkedServiceReference"
					},
					"name": "sink"
				},
				{
					"linkedService": {
						"referenceName": "AzureDataLakeLinkedService",
						"type": "LinkedServiceReference"
					},
					"name": "sinkFlight"
				},
				{
					"linkedService": {
						"referenceName": "AzureDataLakeLinkedService",
						"type": "LinkedServiceReference"
					},
					"name": "sinkDimPassenger"
				},
				{
					"linkedService": {
						"referenceName": "AzureDataLakeLinkedService",
						"type": "LinkedServiceReference"
					},
					"name": "sinkFactBooking"
				},
				{
					"linkedService": {
						"referenceName": "AzureDataLakeLinkedService",
						"type": "LinkedServiceReference"
					},
					"name": "sinkDimAirport"
				}
			],
			"transformations": [
				{
					"name": "derivedColumnCountry"
				},
				{
					"name": "selectCols"
				},
				{
					"name": "RenameCol"
				},
				{
					"name": "derivedGenderMaleFlag"
				},
				{
					"name": "deriveGenderFemaleFlag"
				},
				{
					"name": "filterGreaterthan25"
				},
				{
					"name": "derivedName"
				},
				{
					"name": "castTicketCost"
				},
				{
					"name": "derivedAirportName"
				},
				{
					"name": "alterRow"
				},
				{
					"name": "castId"
				},
				{
					"name": "alterRowFlight"
				},
				{
					"name": "alterRowDimPassenger"
				},
				{
					"name": "castDimPassenger"
				},
				{
					"name": "castFactBooking"
				},
				{
					"name": "alterRowFactBooking"
				},
				{
					"name": "castDimAirport"
				},
				{
					"name": "alterRowDimAirport"
				}
			],
			"scriptLines": [
				"source(output(",
				"          airline_id as short,",
				"          airline_name as string,",
				"          country as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> DimAirline",
				"source(output(",
				"          flight_id as short,",
				"          flight_number as string,",
				"          departure_time as string,",
				"          arrival_time as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> DimFlight",
				"source(output(",
				"          passenger_id as short,",
				"          full_name as string,",
				"          gender as string,",
				"          age as short,",
				"          country as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> DimPassenger",
				"source(output(",
				"          booking_id as integer,",
				"          passenger_id as integer,",
				"          flight_id as integer,",
				"          airline_id as integer,",
				"          origin_airport_id as integer,",
				"          destination_airport_id as integer,",
				"          booking_date as date,",
				"          ticket_cost as decimal(10,2),",
				"          flight_duration_mins as integer,",
				"          checkin_status as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet') ~> FactBooking",
				"source(output(",
				"          airport_id as integer,",
				"          airport_name as string,",
				"          city as string,",
				"          country as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     documentForm: 'arrayOfDocuments') ~> dimAirport",
				"DimAirline derive(country = upper(country)) ~> derivedColumnCountry",
				"DimFlight select(mapColumn(",
				"          flight_id,",
				"          flight_number,",
				"          departure_timestamp = departure_time,",
				"          arrival_time",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selectCols",
				"DimPassenger select(mapColumn(",
				"          passenger_id,",
				"          full_name,",
				"          gender_flag = gender,",
				"          age,",
				"          country",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> RenameCol",
				"RenameCol derive(gender_flag = replace(gender_flag, \"M\", \"Male\")) ~> derivedGenderMaleFlag",
				"derivedGenderMaleFlag derive(gender_flag = replace(gender_flag, 'F', 'Female')) ~> deriveGenderFemaleFlag",
				"deriveGenderFemaleFlag filter(age>25) ~> filterGreaterthan25",
				"filterGreaterthan25 derive(first_name = split(full_name,' ')[1],",
				"          last_name = split(full_name, ' ')[2]) ~> derivedName",
				"FactBooking cast(output(",
				"          ticket_cost as integer",
				"     ),",
				"     errors: true) ~> castTicketCost",
				"dimAirport derive(airport_name = upper(airport_name)) ~> derivedAirportName",
				"castId alterRow(upsertIf(1==1)) ~> alterRow",
				"derivedColumnCountry cast(output(",
				"          airline_id as integer",
				"     ),",
				"     errors: true) ~> castId",
				"selectCols alterRow(upsertIf(1==1)) ~> alterRowFlight",
				"castDimPassenger alterRow(upsertIf(1==1)) ~> alterRowDimPassenger",
				"derivedName cast(output(",
				"          passenger_id as string",
				"     ),",
				"     errors: true) ~> castDimPassenger",
				"castTicketCost cast(output(",
				"          booking_id as string",
				"     ),",
				"     errors: true) ~> castFactBooking",
				"castFactBooking alterRow(upsertIf(1==1)) ~> alterRowFactBooking",
				"derivedAirportName cast(output(",
				"          airport_id as string",
				"     ),",
				"     errors: true) ~> castDimAirport",
				"castDimAirport alterRow(upsertIf(1==1)) ~> alterRowDimAirport",
				"alterRow sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'delta',",
				"     fileSystem: 'silver',",
				"     folderPath: 'DimAirLine',",
				"     mergeSchema: false,",
				"     autoCompact: false,",
				"     optimizedWrite: false,",
				"     vacuum: 0,",
				"     deletable: false,",
				"     insertable: false,",
				"     updateable: false,",
				"     upsertable: true,",
				"     keys:[('airline_id')],",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> sink",
				"alterRowFlight sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'delta',",
				"     fileSystem: 'silver',",
				"     folderPath: 'DimFlight',",
				"     mergeSchema: false,",
				"     autoCompact: false,",
				"     optimizedWrite: false,",
				"     vacuum: 0,",
				"     deletable: false,",
				"     insertable: false,",
				"     updateable: false,",
				"     upsertable: true,",
				"     keys:[('flight_id')],",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> sinkFlight",
				"alterRowDimPassenger sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'delta',",
				"     fileSystem: 'silver',",
				"     folderPath: 'DimPassenger',",
				"     mergeSchema: false,",
				"     autoCompact: false,",
				"     optimizedWrite: false,",
				"     vacuum: 0,",
				"     deletable: false,",
				"     insertable: false,",
				"     updateable: false,",
				"     upsertable: true,",
				"     keys:[('passenger_id')],",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> sinkDimPassenger",
				"alterRowFactBooking sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'delta',",
				"     fileSystem: 'silver',",
				"     folderPath: 'FactBooking',",
				"     mergeSchema: false,",
				"     autoCompact: false,",
				"     optimizedWrite: false,",
				"     vacuum: 0,",
				"     deletable: false,",
				"     insertable: false,",
				"     updateable: false,",
				"     upsertable: true,",
				"     keys:[('booking_id')],",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> sinkFactBooking",
				"alterRowDimAirport sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'delta',",
				"     fileSystem: 'silver',",
				"     folderPath: 'DimAirport',",
				"     mergeSchema: false,",
				"     autoCompact: false,",
				"     optimizedWrite: false,",
				"     vacuum: 0,",
				"     deletable: false,",
				"     insertable: false,",
				"     updateable: false,",
				"     upsertable: true,",
				"     keys:[('airport_id')],",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> sinkDimAirport"
			]
		}
	}
}