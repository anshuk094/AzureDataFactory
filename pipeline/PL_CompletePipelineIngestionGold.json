{
	"name": "PL_CompletePipelineIngestionGold",
	"properties": {
		"activities": [
			{
				"name": "SetYearVariable",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "vYear",
					"value": {
						"value": "@formatDateTime(pipeline().parameters.pRunDate,'yyyy')",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Set variable Month",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "SetYearVariable",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "vMonth",
					"value": {
						"value": "@formatDateTime(pipeline().parameters.pRunDate,'MM')",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Set variable Day",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Set variable Month",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "vDay",
					"value": {
						"value": "@formatDateTime(pipeline().parameters.pRunDate,'dd')",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Get Metadata Raw Directory",
				"description": "To check if folder exists or not",
				"type": "GetMetadata",
				"dependsOn": [
					{
						"activity": "Set variable Day",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "parametrized_source_path",
						"type": "DatasetReference",
						"parameters": {
							"year": {
								"value": "@variables('vYear')",
								"type": "Expression"
							},
							"month": {
								"value": "@variables('vMonth')",
								"type": "Expression"
							},
							"day": {
								"value": "@variables('vDay')",
								"type": "Expression"
							}
						}
					},
					"fieldList": [
						"exists"
					],
					"storeSettings": {
						"type": "AzureBlobFSReadSettings",
						"enablePartitionDiscovery": false
					},
					"formatSettings": {
						"type": "DelimitedTextReadSettings"
					}
				}
			},
			{
				"name": "Get Metadata FileName",
				"type": "GetMetadata",
				"dependsOn": [
					{
						"activity": "Get Metadata Raw Directory",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "parametrized_source_path",
						"type": "DatasetReference",
						"parameters": {
							"year": {
								"value": "@variables('vYear')",
								"type": "Expression"
							},
							"month": {
								"value": "@variables('vMonth')",
								"type": "Expression"
							},
							"day": {
								"value": "@variables('vDay')",
								"type": "Expression"
							}
						}
					},
					"fieldList": [
						"childItems"
					],
					"storeSettings": {
						"type": "AzureBlobFSReadSettings",
						"enablePartitionDiscovery": false
					},
					"formatSettings": {
						"type": "DelimitedTextReadSettings"
					}
				}
			},
			{
				"name": "ForEach",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "Get Metadata FileName",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('Get Metadata FileName').output.childItems",
						"type": "Expression"
					},
					"batchCount": 5,
					"activities": [
						{
							"name": "If Condition",
							"type": "IfCondition",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"expression": {
									"value": "@endswith(item().name,'.csv' )",
									"type": "Expression"
								},
								"ifTrueActivities": [
									{
										"name": "Copy data to Silver Layer",
										"type": "Copy",
										"dependsOn": [],
										"policy": {
											"timeout": "0.12:00:00",
											"retry": 0,
											"retryIntervalInSeconds": 30,
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"source": {
												"type": "DelimitedTextSource",
												"storeSettings": {
													"type": "AzureBlobFSReadSettings",
													"recursive": true,
													"enablePartitionDiscovery": false
												},
												"formatSettings": {
													"type": "DelimitedTextReadSettings"
												}
											},
											"sink": {
												"type": "DelimitedTextSink",
												"storeSettings": {
													"type": "AzureBlobFSWriteSettings"
												},
												"formatSettings": {
													"type": "DelimitedTextWriteSettings",
													"quoteAllText": true,
													"fileExtension": ".txt"
												}
											},
											"enableStaging": false,
											"translator": {
												"type": "TabularTranslator",
												"typeConversion": true,
												"typeConversionSettings": {
													"allowDataTruncation": true,
													"treatBooleanAsNumber": false
												}
											}
										},
										"inputs": [
											{
												"referenceName": "parametrized_raw_path_dataset",
												"type": "DatasetReference",
												"parameters": {
													"year": {
														"value": "@variables('vYear')",
														"type": "Expression"
													},
													"month": {
														"value": "@variables('vMonth')",
														"type": "Expression"
													},
													"day": {
														"value": "@variables('vDay')",
														"type": "Expression"
													}
												}
											}
										],
										"outputs": [
											{
												"referenceName": "parametrized_silver_path_dataset",
												"type": "DatasetReference",
												"parameters": {
													"year": {
														"value": "@variables('vYear')",
														"type": "Expression"
													},
													"month": {
														"value": "@variables('vMonth')",
														"type": "Expression"
													},
													"day": {
														"value": "@variables('vDay')",
														"type": "Expression"
													}
												}
											}
										]
									},
									{
										"name": "Data flow",
										"type": "ExecuteDataFlow",
										"dependsOn": [
											{
												"activity": "Copy data to Silver Layer",
												"dependencyConditions": [
													"Succeeded"
												]
											}
										],
										"policy": {
											"timeout": "0.12:00:00",
											"retry": 0,
											"retryIntervalInSeconds": 30,
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"dataflow": {
												"referenceName": "dataflowSilverLayerTransformation",
												"type": "DataFlowReference",
												"datasetParameters": {
													"sourceSilverLayer": {
														"year": "2025",
														"month": "01",
														"day": "30"
													}
												}
											},
											"compute": {
												"coreCount": 8,
												"computeType": "General"
											},
											"traceLevel": "Fine"
										}
									}
								]
							}
						}
					]
				}
			}
		],
		"parameters": {
			"pRunDate": {
				"type": "string",
				"defaultValue": "2025-01-30"
			}
		},
		"variables": {
			"vYear": {
				"type": "String",
				"defaultValue": "2025"
			},
			"vMonth": {
				"type": "String",
				"defaultValue": "01"
			},
			"vDay": {
				"type": "String",
				"defaultValue": "30"
			}
		},
		"annotations": []
	}
}