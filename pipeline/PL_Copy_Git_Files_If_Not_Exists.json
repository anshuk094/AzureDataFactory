{
	"name": "PL_Copy_Git_Files_If_Not_Exists",
	"properties": {
		"activities": [
			{
				"name": "Get_Git_File_List",
				"type": "WebActivity",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 2,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "GET",
					"url": "https://api.github.com/repos/anshlambagit/AnshLambaYoutube/contents/ADF_Project/"
				}
			},
			{
				"name": "ForEach_Git_Files",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "Get_Git_File_List",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@json(activity('Get_Git_File_List').output.Response)",
						"type": "Expression"
					},
					"activities": [
						{
							"name": "If_Is_CSV",
							"type": "IfCondition",
							"dependsOn": [
								{
									"activity": "If_File_Not_Exists",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"expression": {
									"value": "@and(\n  endswith(item().name, '.csv'),\n  equals(activity('If_File_Not_Exists').output.exists, true)\n)",
									"type": "Expression"
								},
								"ifFalseActivities": [
									{
										"name": "Copy_Git_File_To_ADLS",
										"type": "Copy",
										"dependsOn": [],
										"policy": {
											"timeout": "0.12:00:00",
											"retry": 0,
											"retryIntervalInSeconds": 30,
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"source": {
												"type": "DelimitedTextSource",
												"storeSettings": {
													"type": "HttpReadSettings",
													"requestMethod": "GET"
												},
												"formatSettings": {
													"type": "DelimitedTextReadSettings"
												}
											},
											"sink": {
												"type": "DelimitedTextSink",
												"storeSettings": {
													"type": "AzureBlobFSWriteSettings"
												},
												"formatSettings": {
													"type": "DelimitedTextWriteSettings",
													"quoteAllText": true,
													"fileExtension": ".txt"
												}
											},
											"enableStaging": false,
											"translator": {
												"type": "TabularTranslator",
												"typeConversion": true,
												"typeConversionSettings": {
													"allowDataTruncation": true,
													"treatBooleanAsNumber": false
												}
											}
										},
										"inputs": [
											{
												"referenceName": "dataset_git_dource_files",
												"type": "DatasetReference"
											}
										],
										"outputs": [
											{
												"referenceName": "dataset_git_source_files",
												"type": "DatasetReference"
											}
										]
									}
								]
							}
						},
						{
							"name": "If_File_Not_Exists",
							"type": "GetMetadata",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"dataset": {
									"referenceName": "dataset_sink_git_dynamic",
									"type": "DatasetReference",
									"parameters": {
										"fileName": {
											"value": "@item().name",
											"type": "Expression"
										},
										"folderName": " "
									}
								},
								"fieldList": [
									"exists"
								],
								"storeSettings": {
									"type": "AzureBlobFSReadSettings",
									"recursive": true,
									"enablePartitionDiscovery": false
								},
								"formatSettings": {
									"type": "DelimitedTextReadSettings"
								}
							}
						}
					]
				}
			}
		],
		"annotations": [],
		"lastPublishTime": "2025-12-22T15:45:22Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}